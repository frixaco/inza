{
  "name": "inza",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "format": "oxfmt package.json tsconfig*.json .oxlintrc.json .oxfmtrc.json '*.config.{js,ts}' index.html README.md 'src/**/*.{ts,tsx,css}'",
    "format:check": "oxfmt --check package.json tsconfig*.json .oxlintrc.json .oxfmtrc.json '*.config.{js,ts}' index.html README.md 'src/**/*.{ts,tsx,css}'",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@open-spaced-repetition/binding": "^0.5.0",
    "@open-spaced-repetition/binding-wasm32-wasi": "^0.5.0",
    "@stylexjs/stylex": "^0.19.0",
    "dexie": "4.4.4",
    "dexie-react-hooks": "4.4.0",
    "marked": "^18.0.9",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "ts-fsrs": "^5.4.1",
    "valibot": "1.4.2",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@stylexjs/unplugin": "^0.19.0",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "oxfmt": "^0.55.0",
    "oxlint": "^1.70.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vite-plugin-pwa": "^1.3.0"
  }
}
