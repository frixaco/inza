{
  "name": "@inza/mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Expo mobile app for Inza.",
  "main": "index.ts",
  "scripts": {
    "android": "expo run:android",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run doctor",
    "doctor": "expo-doctor",
    "format": "oxfmt . --write",
    "format:check": "oxfmt . --check",
    "ios": "expo run:ios",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "prebuild": "expo prebuild",
    "prebuild:clean": "expo prebuild --clean",
    "start": "expo start --dev-client",
    "typecheck": "tsgo --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@react-navigation/native": "^7.3.1",
    "@react-navigation/native-stack": "^7.17.3",
    "expo": "~56.0.11",
    "expo-asset": "~56.0.17",
    "expo-audio": "~56.0.12",
    "expo-dev-client": "~56.0.20",
    "fflate": "^0.8.3",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "^4.25.2",
    "ts-fsrs": "^5.4.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/react": "~19.2.2",
    "@typescript/native-preview": "^7.0.0-dev.20260527.1",
    "expo-doctor": "^1.19.8",
    "typescript": "~6.0.3"
  },
  "packageManager": "bun@1.4.0",
  "expo": {
    "autolinking": {
      "exclude": [
        "react",
        "react-dom"
      ]
    },
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  }
}
