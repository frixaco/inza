{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "options": {
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "error"
  },
  "env": {
    "builtin": true
  },
  "jsPlugins": ["oxlint-tailwindcss"],
  "settings": {
    "tailwindcss": {
      "entryPoint": "desktop/src/renderer/style.css"
    }
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.expo/**",
    "**/.build/**",
    "mobile/android/**",
    "mobile/ios/**",
    "kaishi-open-deck/**",
    "stuff/kaishi-open-deck/**",
    "stuff/rust-book/**",
    "stuff/rust-book-cards/**"
  ],
  "overrides": [
    {
      "files": [
        "desktop/scripts/**/*.mjs",
        "desktop/vite.config.ts",
        "desktop/rolldown.config.mjs",
        "desktop/src/main/**/*.ts",
        "stuff/**/*.ts",
        "parser/**/*.ts"
      ],
      "env": {
        "node": true
      }
    },
    {
      "files": [
        "desktop/src/renderer/**/*.ts",
        "desktop/src/renderer/**/*.tsx",
        "web/src/**/*.ts",
        "web/src/**/*.tsx"
      ],
      "env": {
        "browser": true
      }
    },
    {
      "files": ["desktop/src/renderer/**/*.tsx", "web/src/**/*.tsx"],
      "rules": {
        "tailwindcss/no-unknown-classes": "error",
        "tailwindcss/no-duplicate-classes": "error",
        "tailwindcss/no-conflicting-classes": "error",
        "tailwindcss/no-deprecated-classes": "error",
        "tailwindcss/no-unnecessary-whitespace": "error",
        "tailwindcss/enforce-canonical": "error",
        "tailwindcss/enforce-shorthand": "error",
        "tailwindcss/enforce-negative-arbitrary-values": "error",
        "tailwindcss/no-arbitrary-value": "error",
        "tailwindcss/no-hardcoded-colors": "error",
        "tailwindcss/no-unnecessary-arbitrary-value": "error"
      }
    },
    {
      "files": ["mobile/**/*.ts", "mobile/**/*.tsx"],
      "env": {
        "browser": true
      }
    }
  ]
}
