{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "options": {
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "error"
  },
  "env": {
    "builtin": true
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.expo/**",
    "**/.build/**",
    "mobile/android/**",
    "mobile/ios/**",
    "kaishi-open-deck/**",
    "stuff/kaishi-open-deck/**",
    "stuff/rust-book/**",
    "stuff/rust-book-cards/**"
  ],
  "overrides": [
    {
      "files": [
        "desktop/scripts/**/*.mjs",
        "desktop/vite.config.ts",
        "desktop/rolldown.config.mjs",
        "desktop/src/main/**/*.ts",
        "stuff/**/*.ts",
        "parser/**/*.ts"
      ],
      "env": {
        "node": true
      }
    },
    {
      "files": [
        "desktop/src/renderer/**/*.ts",
        "desktop/src/renderer/**/*.tsx",
        "web/src/**/*.ts",
        "web/src/**/*.tsx"
      ],
      "env": {
        "browser": true
      }
    },
    {
      "files": ["mobile/**/*.ts", "mobile/**/*.tsx"],
      "env": {
        "browser": true
      }
    }
  ]
}
