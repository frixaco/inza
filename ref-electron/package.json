{
  "name": "manki-ref-electron",
  "version": "0.1.0",
  "private": true,
  "description": "Fresh Electron reference app for Manki.",
  "type": "module",
  "main": "dist/main/main.mjs",
  "scripts": {
    "build": "bun run typecheck && bun run build:main && bun run build:renderer",
    "build:main": "rolldown -c rolldown.config.mjs",
    "build:renderer": "vite build",
    "check": "bun run format:check && bun run lint && bun run typecheck",
    "dev": "bun scripts/dev.mjs",
    "format": "oxfmt . --disable-nested-config --write",
    "format:check": "oxfmt . --disable-nested-config --check",
    "lint": "oxlint . --disable-nested-config",
    "lint:fix": "oxlint . --fix --disable-nested-config",
    "postinstall": "install-electron",
    "start": "electron .",
    "typecheck": "tsgo --noEmit -p tsconfig.json",
    "typecheck:watch": "tsgo --watch --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@typescript/native-preview": "^7.0.0-dev.20260527.1",
    "electron": "^42.3.0",
    "oxfmt": "^0.52.0",
    "oxlint": "^1.67.0",
    "oxlint-tsgolint": "^0.23.0",
    "rolldown": "^1.0.2",
    "vite": "^8.0.14"
  },
  "packageManager": "bun@1.4.0"
}
